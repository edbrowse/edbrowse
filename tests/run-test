#!/bin/sh
# Run one check. The makefile owns the fixture list and parallel scheduling.
[ "$#" -eq 2 ] || exit 2
program=$1
check=$2
cd "$(dirname "$0")" || exit 1
case "$program" in
    /*) ;;
    *) program="$(pwd)/$program" ;;
esac

if [ "$check" = network ]; then
    # Keep requests to external services sequential, and run every check
    # even when an earlier one fails.
    status=0
    for fixture in frames.html xhr.html acid3; do
        ./run-test "$program" "$fixture" || status=1
    done
    exit "$status"
fi

tempdir=$(mktemp -d "${TMPDIR:-/tmp}/edbrowse-test.XXXXXX") || exit 1
trap 'rm -rf "$tempdir"' 0
trap 'exit 1' HUP INT TERM
log=$tempdir/output

case "$check" in
    table-render)
        cat > "$tempdir/expected" <<'EOF'
ok

winston cigarettes
first|middle|last
fred|t|flintstone
wilma|p|flintstone
betty|l|rubble
bambam|y|rubble
hoppy|g|rubble
joe|v|rockhead
anne|p|margrock
great gazoo →3
||

<press3> {here}

a|b|{c} ↓3|d|e
f|g|c|i|j
kl →2|c|no ↓2→2
p|q|r|no
EOF
        if ! "$program" -c "" -d0 table.html > "$log" 2>&1 <<EOF
b
et
w $tempdir/rendered
q
EOF
        then
            echo "table rendering process failed"
            cat "$log"
            exit 1
        fi
        if ! cmp -s "$tempdir/expected" "$tempdir/rendered"; then
            echo "table output has changed"
            cat "$log"
            diff -u "$tempdir/expected" "$tempdir/rendered"
            exit 1
        fi
        cat > "$tempdir/expected" <<'EOF'
ok

winston cigarettes
first|middle|last
row 1
first: fred
middle: t
last: flintstone
row 2
first: wilma
middle: p
last: flintstone
row 1
first: betty
middle: l
last: rubble
row 2
first: bambam
middle: y
last: rubble
row 3
first: hoppy
middle: g
last: rubble
row 1
first: joe
middle: v
last: rockhead
row 2
first: anne
middle: p
last: margrock
row 3
first ⇔ last: great gazoo
row 4
first: 
middle: 
last: 

<press3> {here}

row 1
1: a
2: b
3: {c}
4: d
5: e
row 2
1: f
2: g
3: c
4: i
5: j
row 3
1 ⇔ 2: kl
3: c
4 ⇔ 5: no
row 4
1: p
2: q
3: r
4: no
EOF
        if ! "$program" -c "" -d0 table.html > "$log" 2>&1 <<EOF
b
,ur
et
w $tempdir/rendered
q
EOF
        then
            echo "table rendering process failed"
            cat "$log"
            exit 1
        fi
        if ! cmp -s "$tempdir/expected" "$tempdir/rendered"; then
            echo "table output has changed"
            cat "$log"
            diff -u "$tempdir/expected" "$tempdir/rendered"
            exit 1
        fi
        ;;
    trace)
        if ! EDBROWSE="$program" ./trace/run-trace-alpine e \
            "$tempdir/trace-alpine-edbrowse" > "$log" 2>&1; then
            echo "trace alpine found discrepancies"
            cat "$log"
            exit 1
        fi
        ;;
    *)
        line=1
        expected=ok
        if [ "$check" = acid3 ]; then
            line=3
            expected=69/69
        fi
        wait_commands=tmwait
        if [ "$check" = timer.html ]; then
            # tmwait stops when it sees an interval. This fixture clears its
            # interval after two ticks; sleep runs timers in the meantime.
            wait_commands='sleep 2
tmwait'
        fi
        if ! "$program" -c "" "$check" > "$log" 2>&1 <<EOF
b
$wait_commands
rr
$line
q
EOF
        then
            echo "$check process failed"
            cat "$log"
            exit 1
        fi
        result=$(tail -n 1 "$log")
        if [ "$result" != "$expected" ]; then
            echo "$check failed"
            cat "$log"
            exit 1
        fi
        ;;
esac
