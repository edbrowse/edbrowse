#!/bin/sh
# Keep the standalone interface; GNU make schedules the individual checks.
usage()
{
    echo "usage: runtests [-l] [-t] [-j jobs]" >&2
    exit 2
}

local_tests=
trace_tests=
jobs=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -l) local_tests=1 ;;
        -t) trace_tests=1 ;;
        -j)
            shift
            [ "$#" -gt 0 ] && [ -n "$1" ] || usage
            jobs=$1 ;;
        -j?*) jobs=${1#-j} ;;
        *) usage ;;
    esac
    shift
done
if [ -n "$jobs" ]; then
    case "$jobs" in *[!0-9]*) usage ;; esac
    [ "$jobs" -gt 0 ] 2>/dev/null || usage
fi

testdir=$(CDPATH= cd "$(dirname "$0")" && pwd) || exit 1
set -- --no-print-directory -s -k --output-sync=target -C "$testdir" \
    "LOCAL=$local_tests" "TRACE=$trace_tests" test
[ -z "$jobs" ] || set -- "$@" "-j$jobs"
if "${MAKE:-make}" "$@"; then
    exit 0
fi
exit 1
